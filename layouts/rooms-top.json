{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.10"
  },
  "type": "column",
  "children": [
    {
      "id": "strip",
      "type": "row",
      "children": [
        {
          "id": "spaces",
          "type": "block",
          "content": {
            "mod": "rooms",
            "props": {
              "strip": true
            }
          },
          "size": {
            "weight": 1
          },
          "min": 200,
          "window_drag": true
        },
        {
          "id": "agents",
          "type": "block",
          "content": {
            "mod": "agents-calm"
          },
          "size": {
            "weight": 1
          },
          "min": 160
        }
      ],
      "size": {
        "px": 240
      },
      "min": 120,
      "max": 700,
      "divider": {
        "width": 1,
        "color": "border"
      }
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-graph"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-calm"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "#1e1e2e00",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 4,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 4,
          "gap": 4
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 1,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
